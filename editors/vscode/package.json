{
  "activationEvents": [
    "onLanguage:kabir"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "properties": {
        "kabir.serverCommand": {
          "default": "kabir",
          "description": "Command used to start the Kabir language server (`kabir lsp`). Change it if `kabir` is not on your PATH, e.g. an absolute path to the kabir executable.",
          "type": "string"
        }
      },
      "title": "Kabir"
    },
    "grammars": [
      {
        "language": "kabir",
        "path": "./syntaxes/kabir.tmLanguage.json",
        "scopeName": "source.kabir"
      }
    ],
    "languages": [
      {
        "aliases": [
          "Kabir",
          "kabir"
        ],
        "configuration": "./language-configuration.json",
        "extensions": [
          ".kbr"
        ],
        "id": "kabir"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "description": "Kabir language support: syntax highlighting and a language server (diagnostics, completion, hover, go to definition, formatting).",
  "displayName": "Kabir",
  "engines": {
    "vscode": "^1.85.0"
  },
  "license": "MIT",
  "main": "./extension.js",
  "name": "kabir",
  "publisher": "kabir-lang",
  "scripts": {
    "vscode:prepublish": "echo \"kabir extension: no build step (plain JavaScript client)\""
  },
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/afrainkabirrafid/Kabir.git"
  }
}
