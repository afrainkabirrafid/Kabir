#!/usr/bin/env python3
"""Launcher for the Kabir interpreter.

Note: a file named `kabir` cannot sit at the repo root next to the
`kabir/` package directory (same path), so the launcher lives in bin/.
`python -m kabir` from the repo root works exactly the same way.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from kabir.cli import main

if __name__ == "__main__":
    sys.exit(main())
