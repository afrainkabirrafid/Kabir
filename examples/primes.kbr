# primes.kbr -- prints all primes up to 100.

func is_prime(n) {
    if n < 2 {
        return false
    }
    let i = 2
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i += 1
    }
    return true
}

print("Primes up to 100:")
for n in range(2, 101) {
    if is_prime(n) {
        print(n)
    }
}
